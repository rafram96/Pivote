# Plantilla de variables del backend del pivote InfoObras.
# Copiar a `.env` (raíz del repo) y ajustar. Lo carga backend/api/app.py (python-dotenv).
# El `.env` real NO se commitea; este `.env.example` sí (es la referencia).

# Modo de etapas:
#   real      = cruces reales contra SUNAT/InfoObras (producción).
#   esqueleto = stubs, sin red (prueba de transporte).
PIVOTE_ETAPAS=real

# Documentos InfoObras al ZIP. Sin definir = baja TODO (default producción).
# 0 = ninguna (solo transporte) · N>0 = tope (solo para acotar pruebas).
# PIVOTE_MAX_DESCARGAS=

# Carpeta de destino de los datos (una carpeta por job + concursos en la raíz).
# Default: backend/datos_pivote. Una ruta RELATIVA queda anclada a backend/ (no
# al directorio desde donde corras la API o un script); una ABSOLUTA se respeta
# tal cual. La leen la API y todos los scripts (vía backend/config.py).
# PIVOTE_DATA_DIR=datos_pivote
# PIVOTE_DATA_DIR=D:\InfoObras\datos

# --- Afinamiento opcional (defaults razonables) ---
# INFOOBRAS_DOWNLOAD_RETRIES=3
# INFOOBRAS_DOWNLOAD_BASE_DELAY=1.0
# SUNAT_MAX_RETRIES=3
# SUNAT_RETRY_BASE_DELAY=0.5
# SUNAT_THROTTLE_DELAY=0.3
# SUNAT_CACHE_TTL_DAYS=30        # solo si se cablea el caché Postgres (hoy no se usa)
