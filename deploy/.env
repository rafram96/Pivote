# Config del despliegue (docker compose la lee desde deploy/.env). NO se commitea.
# Copiado de .env.example — AJUSTAR los 2 valores marcados abajo antes del deploy real.

# Puertos publicados en el host.
PANEL_PORT=3002          # URL que abre el ingeniero: http://<server>:3002
BACKEND_PORT=8001        # API directo. REQUERIDO en LAN: el browser baja el ZIP directo + el MCP

# IP LAN del server (adaptador Wi-Fi 2, del ipconfig) — el BROWSER de Manuel la
# usa para bajar el ZIP directo del backend. Es build-time del panel: si la IP
# del server cambia, hay que reconstruir el panel (docker compose build panel).
NEXT_PUBLIC_PIVOTE_API=http://192.168.100.5:8001

# Modo del backend: real = cruces SUNAT/InfoObras en vivo · esqueleto = stubs sin red.
PIVOTE_ETAPAS=real

# Documentos InfoObras al ZIP: sin definir = baja TODO (default producción).
# PIVOTE_MAX_DESCARGAS=

# Reintentos de scraping (portal InfoObras intermitente).
INFOOBRAS_DOWNLOAD_RETRIES=5
SUNAT_MAX_RETRIES=5

# ⚠ AJUSTAR: contraseña del Postgres de respaldo (servicio `db`). El puerto NO se
# publica (solo red interna del compose), pero igual poné una clave propia.
DB_PASSWORD=cambiar-esta-clave
