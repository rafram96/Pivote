# Config del despliegue (docker compose la lee automáticamente desde deploy/.env).
# Copiar a `deploy/.env` y ajustar. El .env real NO se commitea.

# Puertos publicados en el host.
PANEL_PORT=3002          # URL que abre el ingeniero: http://<server>:3002
BACKEND_PORT=8001        # API directo (opcional; el panel lo alcanza por red interna)

# Modo del backend: real = cruces SUNAT/InfoObras en vivo · esqueleto = stubs sin red.
PIVOTE_ETAPAS=real

# Documentos InfoObras al ZIP: sin definir = baja TODO (default producción).
# 0 = ninguno (solo transporte) · N>0 = tope (solo para acotar pruebas).
# PIVOTE_MAX_DESCARGAS=

# Reintentos de scraping (el portal InfoObras es intermitente). Default deploy = 5.
# INFOOBRAS_DOWNLOAD_RETRIES=5
# SUNAT_MAX_RETRIES=5

# DB_PASSWORD=...        # solo cuando se habilite el servicio `db` (Postgres)
