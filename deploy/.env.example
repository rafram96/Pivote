# Config del despliegue (docker compose la lee automáticamente desde deploy/.env).
# Copiar a `deploy/.env` y ajustar. El .env real NO se commitea.

# Puertos publicados en el host.
PANEL_PORT=3002          # URL que abre el ingeniero: http://<server>:3002
BACKEND_PORT=8001        # API directo. REQUERIDO en LAN: el browser baja el ZIP directo + el MCP

# URL del backend alcanzable por el BROWSER de Manuel (LAN) — build-time del panel.
# El panel la usa para bajar el ZIP DIRECTO del backend (el proxy de Next NO streamea
# archivos de GBs → daría .txt). DEBE ser la IP LAN del server + BACKEND_PORT, NO localhost.
NEXT_PUBLIC_PIVOTE_API=http://192.168.1.50:8001

# Modo del backend: real = cruces SUNAT/InfoObras en vivo · esqueleto = stubs sin red.
PIVOTE_ETAPAS=real

# Documentos InfoObras al ZIP: sin definir = baja TODO (default producción).
# 0 = ninguno (solo transporte) · N>0 = tope (solo para acotar pruebas).
# PIVOTE_MAX_DESCARGAS=

# Reintentos de scraping (el portal InfoObras es intermitente). Default deploy = 5.
# INFOOBRAS_DOWNLOAD_RETRIES=5
# SUNAT_MAX_RETRIES=5

# Contraseña del Postgres de respaldo (servicio `db` del compose) — OBLIGATORIA:
# sin ella el compose aborta. Los datos del backend viven en el volumen
# `datos_pivote` (PIVOTE_DATA_DIR=/datos lo fija el compose, no se toca aquí).
DB_PASSWORD=cambiar-esta-clave
