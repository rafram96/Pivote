# Entorno virtual local
/venv

# Renderizado HTML del plan (versionado solo el .md fuente)
plan_pivote.html

# Memoria, settings y skills locales de Claude Code
/.claude

# Datos del cliente — NO commitear
# Los Excels son entregables de análisis del ingeniero / outputs de Claude sobre
# concursos reales (Indeconsult / Manuel Echandía) con datos identificables.
/docs/files/
/docs/sample_data/
/docs/examples/
/docs/new/
# Insumos del cliente tras el reorg (fixtures de prueba con datos reales)
/fixtures/

# Snapshots de código del backend (Alpamayo-InfoObras).
# El README sí se commitea (explica de dónde se traen y cómo refrescarlos);
# los .py son copias locales para referencia del dev, no fuente de verdad.
/src/referencia/**/*.py

# Cache de Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# Archivos temporales / scratch
_tmp_*
*.tmp

# Binarios descargados de portales (InfoObras DownloadFile) — NO commitear PDFs
/src/tools/_descargas_*/
/descargas_infoobras/
*.pdf
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp



*.html
*.json
