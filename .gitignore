# Entorno virtual local
/venv

# Memoria, settings y skills locales de Claude Code
/.claude

# === Datos del cliente — NO commitear ===
# fixtures/ = insumos reales (PDFs, Excels, docx) de concursos del cliente
# (Indeconsult / Manuel Echandía) con datos identificables.
/fixtures/
/docs/examples/
# docs comerciales (precios, addendum, recotización) — info de negocio, queda local.
/docs/comercial/

# Descargas de portales (PDFs de InfoObras DownloadFile, etc.)
/descargas_infoobras/
**/_descargas_*/

# Cache de Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# Node
**/node_modules/

# Archivos temporales / scratch
_tmp_*
*.tmp

# Binarios pesados / datos crudos
*.pdf
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Variables de entorno locales (config/secrets). La plantilla .env.example SÍ se versiona.
.env
!.env.example

# HTML y JSON crudos: ignorados por defecto. Los dumps de scraping
# (backend/exploracion/_sunat_dump/) traen RUCs reales, y los renders de
# presentaciones son pesados. Excepciones de código abajo.
*.html
*.json

# --- excepciones: código/config que SÍ se versiona ---
!**/package.json
!**/package-lock.json
!**/tsconfig.json
!mcp-server/cowork-config-ejemplo.json
!/plugin/.claude-plugin/plugin.json
!/plugin/.mcp.json
!/docs/nuevos_modulos/*.html
!/backend/observabilidad/*.html
# Fixtures MEF: data PÚBLICA (Banco de Inversiones), necesarios para los tests
# offline de scraping/mef.py — deben versionarse para correr en el server.
!/backend/tests/fixtures/mef/
!/backend/tests/fixtures/mef/*.html
!/backend/tests/fixtures/mef/*.json

# Plugin Cowork: se versiona el manifiesto + build.ps1 + README; las copias de
# la skill y el MCP son build output (regenéralas con plugin/build.ps1).
/plugin/skills/
/plugin/mcp-server/

# Datos locales de la API del pivote (jobs, espejos, entregables, muestras) —
# contienen nombres/RUCs reales del cliente, NO se versionan.
/backend/datos_pivote/
/datos_pivote/

/.pytest_cache
